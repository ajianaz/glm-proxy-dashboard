:80 {
	root * /srv
	encode zstd gzip

	# PWA: service worker must never be cached by the browser
	@sw path /sw.js
	header @sw Cache-Control "no-cache"

	# hashed assets are immutable
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	try_files {path} /index.html
	file_server
}
